# Kavach AI Platform — copy to .env and edit

# --- LLM (OpenAI-compatible) ---
# local (default): Ollama / LM Studio / vLLM
LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL=llama3.1:8b

# All modes: 'off' forces the deterministic offline path (no LLM calls).
# 'off' is the default (offline-first). 'auto' tries the LLM and falls back on error.
KAVACH_LLM=off

# hosted example (uncomment to use OpenAI or a compatible proxy):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000
ENVIRONMENT=development
